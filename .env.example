PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_DIR=./data

# Required for the owner dashboard and OAuth consent.
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: headless admin/MCP fallback for development only.
ADMIN_TOKEN=

# Optional legacy device bootstrap. Leave empty to use browser pairing.
AGENT_SHARED_TOKEN=

# Device agent
REMOTE_MCP_SERVER=ws://localhost:8787/agent
DEVICE_NAME=My computer
ALLOWED_ROOTS=/Users/me/projects
ALLOW_SHELL=false

# Normally DEVICE_ID and DEVICE_TOKEN are generated/persisted by pairing.
DEVICE_ID=
DEVICE_TOKEN=
